# LF everywhere: Godot writes its text resources with LF, and games using this run on Linux too.
* text=auto eol=lf

*.cs     text eol=lf
*.tscn   text eol=lf
*.tres   text eol=lf
*.cfg    text eol=lf
*.uid    text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.godot  text eol=lf
*.csproj text eol=lf

*.png binary
*.wav binary
*.ogg binary
*.mp3 binary
